# Product API settings (generate a fresh secret for deployments)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
WIDGET_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

# Product-owned PostgreSQL database
POSTGRES_DB=personal_ai
POSTGRES_USER=personal_ai
POSTGRES_PASSWORD=change-this-local-password
BACKEND_PORT=8002
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8002
FRONTEND_BASE_URL=http://localhost:3000

# Existing services reachable from Docker Desktop on the host
RAG_CORE_BASE_URL=http://host.docker.internal:8000
RAG_CORE_API_KEY=
RAG_TIMEOUT_SECONDS=60
AI_BACKEND_BASE_URL=http://host.docker.internal:8001
AI_BACKEND_API_KEY=
AI_DEFAULT_MODEL=
AI_TIMEOUT_SECONDS=60

# Website crawler; local extraction is supported without a paid account
CRAWLER_EXTRACTOR=local
CRAWLER_FALLBACK=
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=50
CRAWLER_RESPECT_ROBOTS=True
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONTENT_BYTES=2097152
CRAWLER_USER_AGENT=PersonalAIBot/1.0
JINA_API_KEY=
JINA_API_BASE_URL=https://r.jina.ai/
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev

# Credential encryption key: keep stable and secret; generated/derived server-side
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Telegram: HTTPS public URL required before inbound webhook delivery works
TELEGRAM_WEBHOOK_BASE_URL=

DATABASE_URL=sqlite:///local.sqlite3
